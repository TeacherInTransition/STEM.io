rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function callerIsAdminOrTeacher() {
      return isSignedIn() && 
        (request.auth.token.admin == true || request.auth.token.teacher == true);
    }

    // Lesson assets (images, PDFs) uploaded by teachers/admins
    match /lessons/{lessonId}/{allPaths=**} {
      allow read: if true;
      allow write: if callerIsAdminOrTeacher() &&
                    request.resource.size < 10 * 1024 * 1024 && // 10MB limit per image
                    request.resource.contentType.matches('image/(webp|png|jpeg|jpg)');
    }

    // Default deny for everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
