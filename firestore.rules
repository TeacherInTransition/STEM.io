rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return true; /* For prototype, everyone can be admin */ }

    // User Rules
    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'role', 'isAdmin', 'stemios', 'streak']) &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['student', 'teacher'] &&
             data.isAdmin is bool &&
             data.stemios is number &&
             data.streak is number;
    }

    match /users/{userId} {
      allow read, write: if true; // Open for prototyping
    }

    // Classroom Rules
    match /classes/{classId} {
      allow read, write: if true; // Open for prototyping
    }

    // Activity Rules
    match /activities/{activityId} {
      allow read, write: if true; // Open for prototyping
    }

    // Lesson Rules
    match /lessons/{lessonId} {
      allow read, write: if true; // Open for prototyping
    }
  }
}
