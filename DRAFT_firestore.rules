rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'role', 'isAdmin', 'stemios', 'streak']) &&
             data.keys().size() == 6 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['student', 'teacher'] &&
             data.isAdmin is bool &&
             data.stemios is number &&
             data.streak is number;
    }

    function isValidActivity(data) {
      return data.keys().hasAll(['userId', 'unitId', 'reward', 'timestamp']) &&
             data.keys().size() == 4 &&
             data.userId == request.auth.uid &&
             isValidId(data.unitId) &&
             data.reward is number &&
             data.timestamp is timestamp;
    }

    // User Rules
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isEmailVerified() && userId == request.auth.uid && isValidUser(incoming());
      allow update: if isSignedIn() && isEmailVerified() && userId == request.auth.uid && 
                    isValidUser(incoming()) &&
                    // Prevent role escalation and field poisoning
                    incoming().role == existing().role &&
                    incoming().isAdmin == existing().isAdmin &&
                    incoming().email == existing().email &&
                    incoming().diff(existing()).affectedKeys().hasAny(['name', 'stemios', 'streak']);
    }

    // Activity Rules
    match /activities/{activityId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || 
                  get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher');
      allow create: if isSignedIn() && isEmailVerified() && isValidActivity(incoming());
      allow delete: if false; 
    }
  }
}
